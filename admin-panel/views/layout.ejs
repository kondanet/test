<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Snake.io Admin Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
    <div class="admin-container">
        <% if (typeof admin !== 'undefined' && admin) { %>
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h2><i class="fas fa-gamepad"></i> Snake.io</h2>
                <p>Admin Panel</p>
            </div>
            
            <ul class="sidebar-nav">
                <li>
                    <a href="/dashboard" class="<%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/users" class="<%= typeof page !== 'undefined' && page === 'users' ? 'active' : '' %>">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li>
                    <a href="/games" class="<%= typeof page !== 'undefined' && page === 'games' ? 'active' : '' %>">
                        <i class="fas fa-trophy"></i>
                        <span>Games</span>
                    </a>
                </li>
                <li>
                    <a href="/analytics" class="<%= typeof page !== 'undefined' && page === 'analytics' ? 'active' : '' %>">
                        <i class="fas fa-chart-bar"></i>
                        <span>Analytics</span>
                    </a>
                </li>
                <li>
                    <a href="/settings" class="<%= typeof page !== 'undefined' && page === 'settings' ? 'active' : '' %>">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <div class="admin-info">
                    <div class="admin-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="admin-details">
                        <div class="admin-name"><%= admin.username %></div>
                        <div class="admin-role">Administrator</div>
                    </div>
                </div>
                <form action="/logout" method="POST" class="logout-form">
                    <button type="submit" class="logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </nav>
        
        <!-- Main Content -->
        <main class="main-content">
            <header class="content-header">
                <div class="header-left">
                    <h1><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
                    <% if (typeof subtitle !== 'undefined') { %>
                    <p class="subtitle"><%= subtitle %></p>
                    <% } %>
                </div>
                <div class="header-right">
                    <div class="header-actions">
                        <button class="btn btn-icon" id="refresh-btn" title="Refresh">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <div class="status-indicator">
                            <span class="status-dot online"></span>
                            <span>Online</span>
                        </div>
                    </div>
                </div>
            </header>
            
            <div class="content-body">
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%= error %>
                </div>
                <% } %>
                
                <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <%= success %>
                </div>
                <% } %>
                
                <%- body %>
            </div>
        </main>
        <% } else { %>
        <!-- Login Layout -->
        <div class="login-container">
            <%- body %>
        </div>
        <% } %>
    </div>
    
    <script src="/js/admin.js"></script>
    <% if (typeof scripts !== 'undefined') { %>
        <% scripts.forEach(script => { %>
            <script src="<%= script %>"></script>
        <% }) %>
    <% } %>
</body>
</html>